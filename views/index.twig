<!DOCTYPE html>
<html lang="fr">
	<head>
		<meta charset="UTF-8"/>
		<title>Chat V3</title>
		 <script src="/socket.io/socket.io.js"></script>
		 <script src="/client.js" defer></script>
		<link rel="stylesheet" href="/styles.css"/>
	</head>
	<body>
		<div class="chat-wrapper">
			<div class="chat-header">
				<span class="chat-title">💬 Chat App</span>
				{% if pseudo is defined and pseudo %}
					<p class="chat-subtitle">Bienvenue
						<strong>@{{ pseudo|e }}</strong>
						!</p>
				{% endif %}
			</div>
			{% if not pseudo is defined or not pseudo %}
				<form id="pseudo-form">
					<div id="pseudo-container">
						<p>Bienvenue, veuillez entrer votre pseudo pour commencer à discuter.</p>
						<input type="text" id="pseudo-input" placeholder="Votre pseudo" required/>
						<button type="submit">Commencer</button>
					</div>
				</form>
			{% endif %}
			<div id="chat-container" style="display:none;">
				<h2>Discussion</h2>
				<ul id="messages"></ul>
				<form class="chat-form" id="form" autocomplete="off">
					<input id="message" autocomplete="off" placeholder="Votre message" required autofocus>
					<button type="submit">Envoyer</button>
				</form>
			</div>
		</div>
	</body>
</html>
